{
  "name": "toz",
  "productName": "ToZ",
  "description": "ToZ 待办、Windows 多电脑同步与桌面透明浮窗",
  "author": "ToZ",
  "license": "UNLICENSED",
  "main": "desktop/main.cjs",
  "version": "1.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "desktop": "electron .",
    "install:runtime": "node node_modules/electron/install.js",
    "build:win": "node scripts/build-win.cjs",
    "prepare:android": "node scripts/prepare-android.mjs",
    "build:android": "node scripts/build-android.mjs",
    "test:android": "node --test mobile/runtime.test.mjs",
    "test:android-ui": "node scripts/prepare-android.mjs && electron mobile/ui-smoke.cjs",
    "test": "node --test prototype/domain.test.mjs prototype/task-list.test.mjs desktop/store.test.cjs desktop/startup.test.cjs prototype/gantt.test.mjs prototype/recurrence.test.mjs prototype/planning.test.mjs prototype/lifecycle.test.mjs prototype/trash.test.mjs desktop/reading-settings.test.cjs desktop/widget-menu.test.cjs desktop/cloud.test.cjs",
    "test:cloud": "node --test desktop/cloud.test.cjs desktop/store.test.cjs desktop/reading-settings.test.cjs",
    "smoke": "electron . --smoke-test --toz-data=.runtime/smoke --smoke-result=artifacts/desktop-smoke/result.json"
  },
  "devDependencies": {
    "7zip-bin": "5.2.0",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "lunar-javascript": "1.7.7",
    "rcedit": "5.0.2"
  }
}
